{
  "name": "mucis",
  "version": "1.0.0",
  "description": "Mucis - Autonomous Soundscape Desktop & Web Player with YouTube Music Auto-Sync & Ambient Visuals",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "clean:ports": "node scripts/kill-ports.js",
    "dev": "node scripts/dev.js",
    "tunnel": "npx localtunnel --port 3000 --subdomain mucis-app",
    "tunnel:cf": "cloudflared tunnel --url http://localhost:3000",
    "build:server": "esbuild server/prod.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --packages=external",
    "build": "tsc && vite build && npm run build:server",
    "start": "node dist-server/index.js",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "fast-average-color": "^9.4.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
